<%- include('partials/head') %>

<section class="watch-section">
  <div class="player-wrap">
    <div class="player-container" id="playerContainer">
      <iframe
        id="player"
        src="<%= embeds[0].url %>"
        allowfullscreen="true"
        webkitallowfullscreen="true"
        mozallowfullscreen="true"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen *"
        frameborder="0"
        scrolling="no"
        title="Video player"
      ></iframe>
    </div>
  </div>

  <div class="container watch-meta">
    <div class="server-bar">
      <span class="server-label">Servers</span>
      <div class="servers" id="servers">
        <% embeds.forEach((e, i) => { %>
          <button
            type="button"
            class="server-btn <%= i === 0 ? 'active' : '' %>"
            data-url="<%= e.url %>"
            data-index="<%= i %>"
          ><%= e.name %></button>
        <% }) %>
      </div>
    </div>

    <% if (typeof mediaType !== 'undefined' && mediaType === 'tv') { %>
      <div class="ep-picker">
        <div class="ep-picker-top">
          <label class="server-label" for="seasonSelect">Season</label>
          <select
            id="seasonSelect"
            class="season-select"
            onchange="location.href='/tv/watch/<%= movie.id %>?s='+this.value+'&e=1'"
          >
            <% const list = (typeof seasonList !== 'undefined' && seasonList.length)
                 ? seasonList
                 : Array.from({ length: (typeof seasons !== 'undefined' ? seasons : 1) }, (_, i) => ({ number: i + 1, name: 'Season ' + (i + 1) })); %>
            <% list.forEach(s => { %>
              <option value="<%= s.number %>" <%= s.number === season ? 'selected' : '' %>>
                <%= s.name || ('Season ' + s.number) %><%= s.episode_count ? ' (' + s.episode_count + ' eps)' : '' %>
              </option>
            <% }) %>
          </select>
          <span class="ep-current">Now: S<%= season %>E<%= episode %></span>
        </div>
        <div class="ep-grid">
          <% (typeof episodes !== 'undefined' ? episodes : []).forEach(ep => { %>
            <a
              href="/tv/watch/<%= movie.id %>?s=<%= season %>&e=<%= ep.episode_number %>"
              class="ep-btn <%= ep.episode_number === episode ? 'active' : '' %>"
              title="<%= ep.name || ('Episode ' + ep.episode_number) %>"
            >E<%= ep.episode_number %></a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="movie-header">
      <h1><%= movie.title %></h1>
      <div class="meta-row">
        <% if (movie.release_date) { %><span><%= year(movie.release_date) %></span><% } %>
        <% if (movie.runtime) { %><span><%= movie.runtime %> min</span><% } %>
        <% if (movie.vote_average) { %><span class="score">★ <%= movie.vote_average.toFixed(1) %></span><% } %>
        <% if (movie.genres && movie.genres.length) { %>
          <span class="genres">
            <% movie.genres.slice(0, 3).forEach(g => { %>
              <a href="/genre/<%= g.id %>"><%= g.name %></a>
            <% }) %>
          </span>
        <% } %>
      </div>
    </div>

    <p class="overview"><%= movie.overview || 'No description available.' %></p>

    <% if (crew && crew.length) { %>
      <div class="crew">
        <% crew.forEach(c => { %>
          <span><strong><%= c.job %>:</strong> <%= c.name %></span>
        <% }) %>
      </div>
    <% } %>

    <% if (trailer) { %>
      <div class="trailer-section">
        <h3>Trailer</h3>
        <div class="trailer-wrap">
          <iframe src="<%= trailer %>" allowfullscreen allow="autoplay; encrypted-media" title="Trailer"></iframe>
        </div>
      </div>
    <% } %>

    <% if (cast && cast.length) { %>
      <div class="cast-section">
        <h3>Cast</h3>
        <div class="cast-grid">
          <% cast.forEach(p => { %>
            <div class="cast-card">
              <img
                src="<%= img(p.profile_path, 'w185') %>"
                alt="<%= p.name %>"
                loading="lazy"
                onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22185%22 height=%22278%22%3E%3Crect fill=%22%231a1a1a%22 width=%22185%22 height=%22278%22/%3E%3C/svg%3E'"
              >
              <span class="cast-name"><%= p.name %></span>
              <span class="cast-role"><%= p.character %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (similar && similar.length) { %>
      <div class="similar-section">
        <h3>You may also like</h3>
        <div class="movie-grid">
          <% similar.forEach(m => { %>
            <%- include('partials/movie-card', { movie: m }) %>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const iframe = document.getElementById('player');
  const playerContainer = document.getElementById('playerContainer');
  const serverBtns = document.querySelectorAll('.server-btn[data-url]');

  // Server switch
  serverBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      serverBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      if (iframe) iframe.src = btn.getAttribute('data-url');
    });
  });

  // F key → fullscreen (player area only, no overlay button)
  function toggleFullscreen() {
    const el = playerContainer || iframe;
    if (!el) return;

    const isFs =
      document.fullscreenElement ||
      document.webkitFullscreenElement ||
      document.mozFullScreenElement ||
      document.msFullscreenElement;

    if (!isFs) {
      if (el.requestFullscreen) el.requestFullscreen();
      else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
      else if (el.mozRequestFullScreen) el.mozRequestFullScreen();
      else if (el.msRequestFullscreen) el.msRequestFullscreen();
    } else {
      if (document.exitFullscreen) document.exitFullscreen();
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      else if (document.mozCancelFullScreen) document.mozCancelFullScreen();
      else if (document.msExitFullscreen) document.msExitFullscreen();
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 'f') return;
    if (e.target.matches('input, textarea, select')) return;
    e.preventDefault();
    toggleFullscreen();
  });
});
</script>

<%- include('partials/footer') %>
