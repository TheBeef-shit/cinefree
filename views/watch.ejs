<%- include('partials/head') %>

<section class="watch-section">
  <div class="player-wrap">
    <div class="player-container" id="playerContainer">
      <iframe
        id="player"
        src="<%= embeds[0].url %>"
        allowfullscreen
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="no-referrer-when-downgrade"
        frameborder="0"
      ></iframe>
    </div>
  </div>

<div class="container watch-meta">
    <!-- Servers -->
    <div class="server-bar">
      <span class="server-label">Servers</span>
      <div class="servers" id="servers">
        <% embeds.forEach((embed, index) => { %>
          <button
            type="button"
            class="server-btn <%= index === 0 ? 'active' : '' %>"
            data-url="<%= embed.url %>"
            data-index="<%= index %>"
          >
            <%= embed.name %>
          </button>
        <% }) %>

<button type="button" id="fsBtn" class="server-btn server-btn--fs">
          ⛶ Fullscreen
        </button>
      </div>
    </div>

<!-- TV Season & Episode Selector -->
    <% if (typeof mediaType !== 'undefined' && mediaType === 'tv') { %>
      <%
        const currentSeason = Number(season) || 1;
        const currentEpisode = Number(episode) || 1;
        const seasons = (typeof seasonList !== 'undefined' && seasonList.length)
          ? seasonList
          : Array.from({ length: Number(seasons) || 1 }, (_, i) => ({
              number: i + 1,
              name: `Season ${i + 1}`
            }));
        const episodes = (typeof episodes !== 'undefined' && episodes.length) ? episodes : [];
      %>

<div class="tv-selector">
        <div class="tv-selector-header">
          <div class="tv-season-wrapper">
            <label for="seasonSelect" class="tv-label">Season</label>
            <select
              id="seasonSelect"
              class="tv-season-select"
              onchange="window.location.href = `/tv/watch/<%= movie.id %>?s=${this.value}&e=1`"
            >
              <% seasons.forEach(s => { %>
                <% const sNum = Number(s.number || s.season_number); %>
                <option value="<%= sNum %>" <%= sNum === currentSeason ? 'selected' : '' %>>
                  <%= s.name || `Season ${sNum}` %>
                  <% if (s.episode_count) { %> (<%= s.episode_count %> eps) <% } %>
                </option>
              <% }) %>
            </select>
          </div>

<div class="tv-now-playing">
            Now playing: <strong>S<%= currentSeason %> E<%= currentEpisode %></strong>
          </div>
        </div>

<% if (episodes.length > 0) { %>
          <div class="tv-episodes">
            <% episodes.forEach(ep => { %>
              <% const epNum = Number(ep.episode_number || ep.number); %>
              <a
                href="/tv/watch/<%= movie.id %>?s=<%= currentSeason %>&e=<%= epNum %>"
                class="tv-ep <%= epNum === currentEpisode ? 'active' : '' %>"
                title="<%= ep.name || `Episode ${epNum}` %>"
              >
                <%= epNum %>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <p class="tv-no-episodes">No episodes available for this season.</p>
        <% } %>
      </div>
    <% } %>

<!-- Movie / Show Info -->
    <div class="movie-header">
      <h1><%= movie.title %></h1>

<div class="meta-row">
        <% if (movie.release_date) { %>
          <span><%= year(movie.release_date) %></span>
        <% } %>
        <% if (movie.runtime) { %>
          <span><%= movie.runtime %> min</span>
        <% } %>
        <% if (movie.vote_average) { %>
          <span class="score">★ <%= movie.vote_average.toFixed(1) %></span>
        <% } %>
        <% if (movie.genres?.length) { %>
          <span class="genres">
            <% movie.genres.slice(0, 3).forEach(g => { %>
              <a href="/genre/<%= g.id %>"><%= g.name %></a>
            <% }) %>
          </span>
        <% } %>
      </div>
    </div>

<p class="overview"><%= movie.overview || 'No description available.' %></p>

<!-- Crew -->
    <% if (crew?.length) { %>
      <div class="crew">
        <% crew.forEach(c => { %>
          <span><strong><%= c.job %>:</strong> <%= c.name %></span>
        <% }) %>
      </div>
    <% } %>

<!-- Trailer -->
    <% if (trailer) { %>
      <div class="trailer-section">
        <h3>Trailer</h3>
        <div class="trailer-wrap">
          <iframe src="<%= trailer %>" allowfullscreen allow="autoplay; encrypted-media"></iframe>
        </div>
      </div>
    <% } %>

<!-- Cast -->
    <% if (cast?.length) { %>
      <div class="cast-section">
        <h3>Cast</h3>
        <div class="cast-grid">
          <% cast.forEach(person => { %>
            <div class="cast-card">
              <img
                src="<%= img(person.profile_path, 'w185') %>"
                alt="<%= person.name %>"
                loading="lazy"
                onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22185%22 height=%22278%22%3E%3Crect fill=%22%23222222%22 width=%22185%22 height=%22278%22/%3E%3C/svg%3E'"
              />
              <span class="cast-name"><%= person.name %></span>
              <span class="cast-role"><%= person.character %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

<!-- Similar -->
    <% if (similar?.length) { %>
      <div class="similar-section">
        <h3>You may also like</h3>
        <div class="movie-grid">
          <% similar.forEach(m => { %>
            <%- include('partials/movie-card', { movie: m }) %>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const player = document.getElementById('player');
    const fsBtn = document.getElementById('fsBtn');
    const serverButtons = document.querySelectorAll('.server-btn[data-url]');

// Server switching
    serverButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        serverButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

const newSrc = btn.dataset.url;
        if (player && newSrc) {
          player.src = newSrc;
        }
      });
    });

// Fullscreen
    if (fsBtn && player) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) {
          document.exitFullscreen?.();
        } else {
          const request = player.requestFullscreen 
            || player.webkitRequestFullscreen 
            || player.msRequestFullscreen;
          request?.call(player);
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>
