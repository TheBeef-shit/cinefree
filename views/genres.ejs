<%- include('partials/head') %>
<section class="page-header">
  <div class="container">
    <h1>Categories</h1>
    <p>Browse movies by genre · Asian dramas</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <h3 class="cat-subtitle" style="margin-bottom:1rem;color:var(--text-muted)">Asian Drama</h3>
    <div class="genre-grid" style="margin-bottom:2rem">
      <a href="/asian?country=KR" class="genre-card"><span>K-Drama</span></a>
      <a href="/asian?country=CN" class="genre-card"><span>C-Drama</span></a>
      <a href="/asian?country=TW" class="genre-card"><span>Taiwan Drama</span></a>
      <a href="/asian?country=TH" class="genre-card"><span>Thai Drama</span></a>
      <a href="/asian?country=JP" class="genre-card"><span>J-Drama</span></a>
      <a href="/asian?country=ALL" class="genre-card"><span>All Asian</span></a>
    </div>
    <h3 class="cat-subtitle" style="margin-bottom:1rem;color:var(--text-muted)">Movie Genres</h3>
    <div class="genre-grid">
      <% genres.forEach(g => { %>
        <a href="/genre/<%= g.id %>" class="genre-card"><span><%= g.name %></span></a>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
